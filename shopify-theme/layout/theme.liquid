      {%- assign lc_latin = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2190-2199, U+2212, U+2215, U+FEFF, U+FFFD' -%}
      {%- assign lc_latinext = 'U+0100-0130, U+0132-0151, U+0154-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF' -%}
      @font-face{font-family:'Fraunces';font-style:normal;font-weight:500 700;font-display:swap;src:url({{ 'lc-fraunces-latin.woff2' | asset_url }}) format('woff2');unicode-range:{{ lc_latin }}}
      @font-face{font-family:'Fraunces';font-style:normal;font-weight:500 700;font-display:swap;src:url({{ 'lc-fraunces-latinext.woff2' | asset_url }}) format('woff2');unicode-range:{{ lc_latinext }}}
      @font-face{font-family:'Fraunces';font-style:italic;font-weight:400 700;font-display:swap;src:url({{ 'lc-fraunces-italic-latin.woff2' | asset_url }}) format('woff2');unicode-range:{{ lc_latin }}}
