    <!-- Floating Messenger button -->
    {%- assign loc = request.locale.iso_code | downcase -%}
    {%- if loc != 'fr' -%}{%- assign msgr_label = 'Chat with us!' -%}{%- else -%}{%- assign msgr_label = 'Chattez avec nous!' -%}{%- endif -%}
    <a href="https://m.me/AmeubloDirect" target="_blank" rel="noopener" class="lc-msgr" data-umami-event="Messenger Click" aria-label="{{ msgr_label }}" data-tip="{{ msgr_label }}">
      <svg viewBox="0 0 24 24" fill="white" width="28" height="28" aria-hidden="true"><path d="M12 2C6.477 2 2 6.145 2 11.243c0 2.906 1.272 5.506 3.296 7.3V22l3.22-1.778c.86.237 1.77.365 2.714.365 5.523 0 10-4.144 10-9.244S17.523 2 12 2zm1.006 12.43l-2.548-2.72-4.97 2.72 5.467-5.808 2.61 2.72 4.908-2.72-5.467 5.808z"/></svg>
    </a>
    <style>
      .lc-msgr{position:fixed;right:20px;bottom:24px;z-index:9998;width:56px;height:56px;border-radius:50%;background:#0099FF;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(0,0,0,.25);text-decoration:none;animation:lc-msgr-pulse 2s ease-in-out 3;transition:transform .15s ease,box-shadow .15s ease}
      .lc-msgr:hover{transform:scale(1.08);box-shadow:0 6px 20px rgba(0,0,0,.3)}
      .lc-msgr::after{content:attr(data-tip);position:absolute;right:68px;top:50%;transform:translateY(-50%);background:#1A1A2E;color:#fff;font-size:1.3rem;font-weight:600;white-space:nowrap;padding:8px 12px;border-radius:6px;opacity:0;pointer-events:none;transition:opacity .15s ease}
      .lc-msgr::before{content:"";position:absolute;right:62px;top:50%;transform:translateY(-50%);border:6px solid transparent;border-left-color:#1A1A2E;opacity:0;pointer-events:none;transition:opacity .15s ease}
      .lc-msgr:hover::after,.lc-msgr:hover::before{opacity:1}
      @keyframes lc-msgr-pulse{0%{box-shadow:0 4px 14px rgba(0,0,0,.25),0 0 0 0 rgba(0,153,255,.5)}70%{box-shadow:0 4px 14px rgba(0,0,0,.25),0 0 0 14px rgba(0,153,255,0)}100%{box-shadow:0 4px 14px rgba(0,0,0,.25),0 0 0 0 rgba(0,153,255,0)}}
      @media (max-width:749px){.lc-msgr{bottom:90px;right:16px}.lc-msgr::after,.lc-msgr::before{display:none}
      /* La pastille est en position:fixed : en bas de page elle se posait sur la
         rangée des moyens de paiement du footer (constaté en QA mobile 2026-09-13).
         On réserve la hauteur de la pastille + sa marge sous le footer pour que le
         dernier contenu passe au-dessus. Le cadrage de la pastille ne bouge pas. */
      .footer{padding-bottom:88px}}
      @media (prefers-reduced-motion:reduce){.lc-msgr{animation:none}}
      {%- comment -%} 2026-10-16: on phone product pages three floating widgets stacked (Messenger, assistant, sticky add-to-cart). The assistant already answers there, so Messenger steps aside; desktop and other pages unchanged. {%- endcomment -%}
      {%- if request.page_type == 'product' -%}@media (max-width:749px){.lc-msgr{display:none!important}}{%- endif -%}
      {%- comment -%} 2026-10-23: on the phone cart page the fixed bubbles (Messenger, assistant) sat over the total and the "Payer" button; they step aside there. {%- endcomment -%}
      {%- if request.page_type == 'cart' -%}@media (max-width:749px){.lc-msgr,.lc-asst__fab{display:none!important}}{%- endif -%}
      {%- comment -%} 2026-10-24 (Mat): the welcome wheel is the conversion tool. The assistant mascot is hidden everywhere; Messenger stays on desktop only (phones keep the bottom of the screen free for the buy button). {%- endcomment -%}
      .lc-asst__fab{display:none!important}
      @media (max-width:749px){.lc-msgr{display:none!important}}
    </style>
