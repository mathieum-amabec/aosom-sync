    <link rel="preload" href="{{ 'lc-manrope-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'lc-fraunces-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
