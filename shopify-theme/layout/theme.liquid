<!doctype html>
{%- comment -%} SEO audit 2026-10-31 — blog articles have NO translations: the "blog" blog is written in English,
  "actualites" and "guides" in French. Shopify still serves every article on every locale/domain, so the English
  articles showed up on ameublodirect.ca as lang="fr" and the French ones on furnishdirect.ca as en-CA. A blog page
  served in a locale that isn't its writing language gets its real lang attribute and noindex (links still followed). {%- endcomment -%}
{%- liquid
  assign lc_doc_lang = request.locale.iso_code
  assign lc_noindex = false
  if request.page_type == 'article' or request.page_type == 'blog'
    assign lc_blog_lang = 'fr'
    if blog.handle == 'blog'
      assign lc_blog_lang = 'en'
    endif
    if lc_blog_lang != request.locale.iso_code
      assign lc_noindex = true
      assign lc_doc_lang = lc_blog_lang
    endif
  endif
-%}
<html class="js" lang="{{ lc_doc_lang }}">
  <head>
  <script>window.lcT=function(g,e,f,s,p){return g==='fr'?f:(g==='es'&&s!=null?s:(g==='pa'&&p!=null?p:e));};</script>
