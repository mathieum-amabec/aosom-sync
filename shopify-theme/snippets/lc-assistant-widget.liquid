{%- comment -%}
  Ameublo (FR) / Furni (EN) — floating AI shopping assistant (persona since 2026-10-02).
  Since 2026-10-02 the floating button IS the mascot: a little gold armchair (inline SVG, CSS
  animations: idle breathing + blink, wave, thinking, happy). Same drawing in the panel header.
  Bottom-right button opens a bilingual chat modal that calls the public /api/assistant
  endpoint and renders recommended products (image + price + PDP link). Self-contained.
{%- endcomment -%}
{%- assign lc_loc = request.locale.iso_code | downcase -%}
{%- if lc_loc == 'en' -%}{%- assign lc_name = 'Furni' -%}{%- else -%}{%- assign lc_name = 'Ameublo' -%}{%- endif -%}
{%- capture lc_ameublo_svg -%}
<svg class="lc-ameublo" viewBox="0 0 120 120" aria-hidden="true">
  <ellipse cx="60" cy="112" rx="34" ry="4.5" fill="#1b2a47" opacity=".12"/>
  <g class="am-all">
  <g class="am-body">
    <!-- legs -->
    <rect x="31" y="96" width="7" height="14" rx="3" fill="#8a5a2b"/>
    <rect x="82" y="96" width="7" height="14" rx="3" fill="#8a5a2b"/>
    <!-- backrest -->
    <path d="M24 70 C22 34 38 18 60 18 C82 18 98 34 96 70 Z" fill="#D4A853"/>
    <path d="M30 66 C30 38 42 26 60 26 C78 26 90 38 90 66 Z" fill="#E2BC6E"/>
    <!-- tufting buttons -->
    <circle cx="46" cy="36" r="1.6" fill="#C17F3E"/><circle cx="74" cy="36" r="1.6" fill="#C17F3E"/>
    <!-- face -->
    <g class="am-face">
      <g class="am-eye"><ellipse cx="50" cy="48" rx="5" ry="6.4" fill="#1b2a47"/><circle class="am-pupil" cx="51.6" cy="45.8" r="1.8" fill="#fff"/></g>
      <g class="am-eye"><ellipse cx="70" cy="48" rx="5" ry="6.4" fill="#1b2a47"/><circle class="am-pupil" cx="71.6" cy="45.8" r="1.8" fill="#fff"/></g>
      <g class="am-eye-happy" fill="none" stroke="#1b2a47" stroke-width="3" stroke-linecap="round">
        <path d="M45 49 Q50 43 55 49"/><path d="M65 49 Q70 43 75 49"/>
      </g>
      <ellipse cx="42" cy="57" rx="4.2" ry="2.6" fill="#E9897E" opacity=".55"/>
      <ellipse cx="78" cy="57" rx="4.2" ry="2.6" fill="#E9897E" opacity=".55"/>
      <path class="am-mouth-smile" d="M53 57 Q60 64 67 57" fill="none" stroke="#1b2a47" stroke-width="2.6" stroke-linecap="round"/>
      <ellipse class="am-mouth-o" cx="60" cy="59" rx="2.6" ry="3" fill="#1b2a47"/>
    </g>
    <!-- seat -->
    <rect x="22" y="70" width="76" height="28" rx="10" fill="#C99A43"/>
    <rect x="30" y="66" width="60" height="16" rx="8" fill="#FBF3E2"/>
    <path d="M36 74 H84" stroke="#EADCC0" stroke-width="2" stroke-linecap="round"/>
    <!-- left armrest -->
    <rect x="12" y="58" width="20" height="36" rx="10" fill="#D4A853"/>
    <rect x="12" y="58" width="20" height="10" rx="5" fill="#E2BC6E"/>
  </g>
  <!-- right armrest = the waving arm (outside the breathing group so it pivots cleanly) -->
  <g class="am-arm-r">
    <rect x="88" y="58" width="20" height="36" rx="10" fill="#D4A853"/>
    <rect x="88" y="58" width="20" height="10" rx="5" fill="#E2BC6E"/>
  </g>
  </g>
  <!-- thinking dots -->
  <g class="am-think" fill="#1b2a47"><circle cx="98" cy="22" r="2.4"/><circle cx="106" cy="16" r="2.4"/><circle cx="114" cy="10" r="2.4"/></g>
</svg>
{%- endcapture -%}
{%- render 'lc-teaser-core' -%}
<div id="lc-asst" data-loc="{{ lc_loc }}" data-privacy="{{ routes.root_url | append: '/policies/privacy-policy' | replace: '//policies', '/policies' }}" data-api="https://aosom-sync.vercel.app/api/assistant">
  <button type="button" class="lc-asst__fab" aria-label="{% if lc_loc == 'en' %}A question? Ask {{ lc_name }}{% else %}Une question ? Demandez à {{ lc_name }}{% endif %}" aria-expanded="false" aria-controls="lc-asst-panel">
    {{ lc_ameublo_svg }}
    <span class="lc-asst__fab-label"><span class="lc-asst__fab-q">{% if lc_loc == 'en' %}A question?{% else %}Une question ?{% endif %}</span><span class="lc-asst__fab-a">{% if lc_loc == 'en' %}Ask {{ lc_name }}{% else %}Demandez à {{ lc_name }}{% endif %}</span></span>
  </button>

  <div id="lc-asst-panel" class="lc-asst__panel" role="dialog" aria-modal="false" aria-label="{% if lc_loc == 'en' %}Shopping assistant{% else %}Assistant magasinage{% endif %}" hidden>
    <div class="lc-asst__head">
      <div class="lc-asst__who">
        <span class="lc-asst__head-mascot">{{ lc_ameublo_svg }}</span>
        <div>
          <div class="lc-asst__title">{{ lc_name }}</div>
          <div class="lc-asst__subtitle">{% if lc_loc == 'en' %}Your Furnish Direct advisor{% else %}Votre conseiller Ameublo Direct{% endif %}</div>
        </div>
      </div>
      <button type="button" class="lc-asst__close" aria-label="{% if lc_loc == 'en' %}Close{% else %}Fermer{% endif %}">&times;</button>
    </div>
    <div class="lc-asst__body" data-lc-asst-body>
      <div class="lc-asst__msg lc-asst__msg--bot">{% if lc_loc == 'en' %}Hi, I'm {{ lc_name }}! I can help you find the right piece, check if it fits, share decor tips, and answer your questions about delivery, returns or payment.{% else %}Bonjour, je suis {{ lc_name }}&nbsp;! Je peux vous aider à trouver le bon meuble, vérifier s'il entre chez vous, vous donner des idées déco et répondre à vos questions sur la livraison, les retours ou le paiement.{% endif %}</div>
      <div class="lc-asst__chips" data-lc-asst-chips>
        {%- if lc_loc == 'en' -%}
          <button type="button" class="lc-asst__chip">Delivery times and cost</button>
          <button type="button" class="lc-asst__chip">How do returns work?</button>
          <button type="button" class="lc-asst__chip">Can I pay in instalments?</button>
          <button type="button" class="lc-asst__chip">Furnish a living room for $1,500</button>
        {%- else -%}
          <button type="button" class="lc-asst__chip">Délais et frais de livraison</button>
          <button type="button" class="lc-asst__chip">Comment fonctionnent les retours?</button>
          <button type="button" class="lc-asst__chip">Puis-je payer en versements?</button>
          <button type="button" class="lc-asst__chip">Meubler un salon pour 1 500 $</button>
        {%- endif -%}
      </div>
      {%- comment -%} "Ameublo décorateur" — a "bientôt" teaser until settings.decorateur_enabled = "1", then the real
        photo → matching products flow (/api/decorateur). Kept outside the chips so it stays after a first question. {%- endcomment -%}
      <button type="button" class="lc-asst__deco" data-lc-deco>
        <svg class="lc-asst__deco-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8h3l1.6-2.2h6.8L17 8h3v11H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="13.3" r="3.4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M19.5 1.5l.6 1.5 1.5.6-1.5.6-.6 1.5-.6-1.5-1.5-.6 1.5-.6z" fill="#D4A853"/></svg>
        <span class="lc-asst__deco-t" data-lc-deco-label>{% if lc_loc == 'en' %}Decorate my room from a photo{% else %}Décorer ma pièce à partir d'une photo{% endif %}</span>
        <span class="lc-asst__deco-soon" data-lc-deco-soon>{% if lc_loc == 'en' %}Soon{% else %}Bientôt{% endif %}</span>
      </button>
    </div>
    <form class="lc-asst__form" data-lc-asst-form>
      <input type="text" class="lc-asst__input" data-lc-asst-input maxlength="500" autocomplete="off"
             placeholder="{% if lc_loc == 'en' %}Ask {{ lc_name }} anything…{% else %}Posez votre question à {{ lc_name }}…{% endif %}" />
      <button type="submit" class="lc-asst__send" aria-label="{% if lc_loc == 'en' %}Send{% else %}Envoyer{% endif %}">&#10148;</button>
    </form>
  </div>
</div>
<style>
  #lc-asst{--navy:#1B2A4A;--gold:#C17F3E;--gold2:#D4A853;font-family:var(--lc-font-text),sans-serif}
  /* Mascot button: the armchair itself, with its name pill beside it (kept: an unlabeled icon
     went unnoticed on mobile, 2026-09-29). Desktop bottom-right → pill on the left. */
  .lc-asst__fab{position:fixed;right:14px;bottom:10px;z-index:9998;display:flex;flex-direction:row-reverse;align-items:flex-end;gap:.15rem;
    background:none;border:0;padding:0;cursor:pointer;color:#fff;font-size:1.25rem;font-weight:700}
  .lc-asst__fab .lc-ameublo{width:76px;height:76px;filter:drop-shadow(0 4px 8px rgba(0,0,0,.18));transition:transform .2s}
  .lc-asst__fab:hover .lc-ameublo{transform:scale(1.06) rotate(-3deg)}
  .lc-asst__fab-label{background:var(--navy);border:2px solid var(--gold2);border-radius:999px;padding:.45rem .9rem;margin-bottom:22px;
    box-shadow:0 4px 14px rgba(0,0,0,.22);white-space:nowrap}
  /* Two-line pill: small hook ("Une question ?") + bold action, so the button's purpose is obvious. */
  .lc-asst__fab-label{display:flex;flex-direction:column;align-items:flex-start;gap:1px;border-radius:16px;padding:.4rem .9rem;text-align:left;line-height:1.15}
  .lc-asst__fab-q{font-size:1.05rem;font-weight:500;color:var(--gold2);letter-spacing:.02em}
  .lc-asst__fab-a{font-size:1.25rem;font-weight:700;color:#fff}
  .lc-asst__head-mascot .lc-ameublo{width:46px;height:46px;flex:0 0 auto;margin:-6px 0 -4px}
  .lc-ameublo .am-body{transform-origin:60px 104px;animation:am-breathe 3.6s ease-in-out infinite}
  .lc-ameublo .am-eye{transform-box:fill-box;transform-origin:center;animation:am-blink 4.8s infinite}
  .lc-ameublo .am-arm-r{transform-box:fill-box;transform-origin:50% 100%}
  .lc-ameublo .am-all{transform-origin:60px 110px}
  .lc-ameublo .am-think,.lc-ameublo .am-mouth-o,.lc-ameublo .am-eye-happy{opacity:0}
  @keyframes am-breathe{0%,100%{transform:scale(1,1)}50%{transform:scale(1.015,.985)}}
  @keyframes am-blink{0%,94%,100%{transform:scaleY(1)}96%{transform:scaleY(.1)}}
  /* wave */
  .lc-ameublo.is-wave .am-arm-r{animation:am-wave 1.2s ease-in-out 2}
  @keyframes am-wave{0%,100%{transform:translateY(0) rotate(0)}20%{transform:translateY(-16px) rotate(22deg)}40%{transform:translateY(-16px) rotate(-6deg)}60%{transform:translateY(-16px) rotate(22deg)}80%{transform:translateY(-16px) rotate(-6deg)}}
  /* thinking */
  .lc-ameublo.is-thinking .am-pupil{transform:translate(1.6px,-1.8px)}
  .lc-ameublo.is-thinking .am-mouth-smile{opacity:0}
  .lc-ameublo.is-thinking .am-mouth-o{opacity:1}
  .lc-ameublo.is-thinking .am-think{opacity:1}
  .lc-ameublo.is-thinking .am-think circle{animation:am-dots 1.2s ease-in-out infinite}
  .lc-ameublo.is-thinking .am-think circle:nth-child(2){animation-delay:.2s}
  .lc-ameublo.is-thinking .am-think circle:nth-child(3){animation-delay:.4s}
  @keyframes am-dots{0%,100%{transform:translateY(0);opacity:.5}50%{transform:translateY(-3px);opacity:1}}
  /* happy */
  .lc-ameublo.is-happy .am-all{animation:am-hop .5s ease-out 2}
  .lc-ameublo.is-happy .am-eye{opacity:0}
  .lc-ameublo.is-happy .am-eye-happy{opacity:1}
  @keyframes am-hop{0%,100%{transform:translateY(0) scale(1,1)}30%{transform:translateY(0) scale(1.06,.92)}60%{transform:translateY(-7px) scale(.97,1.04)}}
  @media (prefers-reduced-motion:reduce){.lc-ameublo *{animation:none!important}}
  /* Mobile: keep the "Aide au choix" label (an unlabeled 35px icon went unnoticed — 2026-09-29)
     and sit bottom-LEFT, clear of the Messenger bubble (bottom-right). */
  @media(max-width:749px){.lc-asst__fab{left:8px;right:auto;flex-direction:row;bottom:calc(6px + env(safe-area-inset-bottom,0px));font-size:1.15rem}
    .lc-asst__fab .lc-ameublo{width:60px;height:60px} .lc-asst__fab-label{padding:.35rem .75rem;margin-bottom:16px}}
  /* While the sticky "Acheter maintenant" bar is up, lift both floating buttons above it — they
     sat ON the buy button (mobile icon over "Acheter maintenant"). */
  body:has(.sticky-atc.is-visible) .lc-asst__fab{bottom:calc(78px + env(safe-area-inset-bottom,0px))}
  body:has(.sticky-atc.is-visible) .lc-msgr{bottom:calc(90px + env(safe-area-inset-bottom,0px))}
  @media(max-width:749px){body:has(.sticky-atc.is-visible) .lc-msgr{bottom:calc(140px + env(safe-area-inset-bottom,0px))}}
  /* Desktop: both buttons are bottom-right — stack Messenger ABOVE the assistant pill instead of on it. */
  @media(min-width:750px){.lc-msgr{bottom:100px} body:has(.sticky-atc.is-visible) .lc-msgr{bottom:168px}}
  /* 2026-10-14 conversion pass: one overlay at a time. Hide the floating buttons while the entry popup is open,
     and on mobile product pages shrink the assistant to icon-only so it no longer covers price/stars. */
  body:has(#lc-pop.is-open) .lc-asst__fab,body:has(#lc-pop.is-open) .lc-msgr{display:none!important}
{% if template contains 'product' %}  @media(max-width:749px){.lc-asst__fab-label{display:none!important}.lc-asst__fab .lc-ameublo{width:48px;height:48px}}
{% endif %}  /* 2026-10-20: on phones, once the visitor scrolls into the page, the label folds away and only the mascot stays
     (the label comes back near the top), so the assistant, the wheel tab and Messenger don't crowd the products. */
  @media(max-width:749px){#lc-asst.is-mini .lc-asst__fab-label{display:none}#lc-asst.is-mini .lc-asst__fab .lc-ameublo{width:48px;height:48px}}
  .lc-asst__panel{position:fixed;right:20px;bottom:20px;z-index:9999;width:370px;max-width:calc(100vw - 32px);height:70vh;max-height:560px;
    display:flex;flex-direction:column;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,.34)}
  .lc-asst__panel[hidden]{display:none}
  .lc-asst__head{display:flex;align-items:center;justify-content:space-between;background:var(--navy);color:#fff;padding:.85rem 1rem}
  .lc-asst__title{font-size:1.35rem;font-weight:800}
  .lc-asst__who{display:flex;align-items:center;gap:.6rem}
  .lc-asst__subtitle{font-size:1.1rem;opacity:.8;font-weight:500}
  .lc-asst__avatar{display:inline-flex;align-items:center;justify-content:center;width:2.4rem;height:2.4rem;border-radius:50%;background:#D4A853;color:#1b2a47;font-weight:800;font-size:1.3rem;line-height:1;flex:0 0 auto}
  .lc-asst__chips{display:flex;flex-wrap:wrap;gap:.4rem;margin:.2rem 0 .4rem}
  .lc-asst__chip{border:1px solid #D4A853;background:#fff;color:#1b2a47;border-radius:999px;padding:.35rem .75rem;font-size:1.15rem;cursor:pointer}
  .lc-asst__chip:hover{background:#fbf3e2}
  .lc-asst__deco{display:flex;align-items:center;gap:.6rem;width:100%;margin:.1rem 0 .4rem;padding:.7rem .9rem;border:1.5px dashed #D4A853;border-radius:12px;background:#FFFBF2;color:#1b2a47;font:inherit;font-size:1.2rem;font-weight:700;text-align:left;cursor:pointer}
  .lc-asst__deco:hover{background:#fbf3e2}
  .lc-asst__deco:focus-visible,.lc-asst__inline:focus-visible{outline:2px solid #B8553C;outline-offset:2px}
  .lc-asst__deco-ico{width:20px;height:20px;flex:none}
  .lc-asst__deco-t{flex:1;min-width:0}
  .lc-asst__deco-soon{flex:none;padding:.15rem .5rem;border-radius:999px;background:#FBF1DC;color:#8A5A12;font-size:.95rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
  .lc-asst__deco[hidden],.lc-asst__deco-soon[hidden]{display:none}
  .lc-asst__row{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.6rem}
  .lc-asst__inline{position:relative;border:0;border-radius:999px;padding:.45rem .9rem;background:var(--navy);color:#fff;font:inherit;font-size:1.15rem;font-weight:700;cursor:pointer;overflow:hidden}
  .lc-asst__inline--ghost{background:#fff;color:#1b2a47;box-shadow:inset 0 0 0 1px #cfd4de}
  .lc-asst__inline input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer}
  .lc-asst__mini-email{flex:1 1 140px;min-width:0;border:1px solid #d9dee8;border-radius:999px;padding:.45rem .8rem;font:inherit;font-size:16px}
  .lc-asst__mini-email[aria-invalid="true"]{border-color:#B8553C}
  .lc-asst__fine{display:block;margin-top:.4rem;font-size:1rem;color:#797068}
  .lc-asst__fine a{color:inherit}
  .lc-asst__fine[role="alert"]:empty{display:none}
  .lc-asst__fine[role="alert"]{color:#8A2E1C;font-weight:700}
  .lc-asst__msg a{color:inherit;text-decoration:underline;word-break:break-all}
  .lc-asst__close{background:none;border:none;color:#fff;font-size:1.8rem;line-height:1;cursor:pointer}
  .lc-asst__body{flex:1;overflow-y:auto;padding:1rem;display:flex;flex-direction:column;gap:.7rem;background:#F7F6F4}
  .lc-asst__msg{max-width:85%;padding:.6rem .85rem;border-radius:12px;font-size:1.25rem;line-height:1.4}
  .lc-asst__msg--bot{background:#fff;color:#1B2A4A;align-self:flex-start;border:1px solid #e7e3dc}
  .lc-asst__msg--user{background:var(--navy);color:#fff;align-self:flex-end}
  .lc-asst__msg--typing{color:#797068;font-style:italic}
  .lc-asst__cards{display:flex;flex-direction:column;gap:.55rem;align-self:stretch}
  .lc-asst__card{display:flex;gap:.6rem;background:#fff;border:1px solid #e7e3dc;border-radius:12px;padding:.5rem;text-decoration:none;color:#1B2A4A}
  .lc-asst__card:hover{border-color:var(--gold2);box-shadow:0 3px 12px rgba(0,0,0,.1)}
  .lc-asst__card img{width:72px;height:72px;object-fit:cover;border-radius:8px;flex:0 0 auto;background:#eee}
  .lc-asst__card-b{display:flex;flex-direction:column;gap:.15rem;min-width:0}
  .lc-asst__card-name{font-size:1.15rem;font-weight:700;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .lc-asst__card-price{font-size:1.2rem;font-weight:800;color:var(--gold)}
  .lc-asst__card-reason{font-size:1.05rem;color:#797068;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .lc-asst__form{display:flex;gap:.5rem;padding:.7rem;border-top:1px solid #e7e3dc;background:#fff}
  .lc-asst__input{flex:1;border:1px solid #d9dee8;border-radius:999px;padding:.6rem .9rem;font-size:1.2rem;outline:none}
  .lc-asst__input:focus{border-color:var(--gold2)}
  .lc-asst__send{background:var(--gold);color:#fff;border:none;border-radius:999px;width:42px;height:42px;font-size:1.4rem;cursor:pointer;flex:0 0 auto}
  .lc-asst__send:disabled{opacity:.5;cursor:default}
</style>
<script>
(function(){
  var root=document.getElementById('lc-asst'); if(!root) return;
  var LOC=root.getAttribute('data-loc')==='en'?'en':'fr';
  var API=root.getAttribute('data-api');
  var fab=root.querySelector('.lc-asst__fab');
  var panel=root.querySelector('#lc-asst-panel');
  var closeBtn=root.querySelector('.lc-asst__close');
  var body=root.querySelector('[data-lc-asst-body]');
  var form=root.querySelector('[data-lc-asst-form]');
  var input=root.querySelector('[data-lc-asst-input]');
  var send=root.querySelector('.lc-asst__send');
  var history=[]; var busy=false;
  var T=LOC==='en'
    ?{err:"Sorry, something went wrong. Please try again.",typing:"Furni is thinking…"}
    :{err:"Désolé, une erreur est survenue. Réessayez.",typing:"Ameublo réfléchit…"};
  function esc(s){var d=document.createElement('div');d.textContent=s==null?'':String(s);return d.innerHTML.replace(/"/g,'&quot;');}
  function money(n){try{return new Intl.NumberFormat(LOC==='en'?'en-CA':'fr-CA',{style:'currency',currency:'CAD'}).format(n);}catch(e){return '$'+Number(n).toFixed(2);}}
  var fabMascot=fab.querySelector('.lc-ameublo');
  var headMascot=root.querySelector('.lc-asst__head-mascot .lc-ameublo');
  function pose(el,cls,ms){if(!el)return;el.classList.remove('is-wave','is-thinking','is-happy');void el.getBoundingClientRect();el.classList.add(cls);if(ms)setTimeout(function(){el.classList.remove(cls);},ms);}
  function rest(el){if(el)el.classList.remove('is-wave','is-thinking','is-happy');}
  // A friendly wave a few seconds into the first page of the visit (once per session).
  try{if(!sessionStorage.getItem('lc_ameublo_waved')){setTimeout(function(){if(panel.hidden)pose(fabMascot,'is-wave',2600);},4000);sessionStorage.setItem('lc_ameublo_waved','1');}}catch(e){}
  function open(){panel.hidden=false;fab.setAttribute('aria-expanded','true');fab.style.display='none';pose(headMascot,'is-wave',2600);setTimeout(function(){input.focus();},50);}
  function close(){panel.hidden=true;fab.setAttribute('aria-expanded','false');fab.style.display='';}
  fab.addEventListener('click',open); closeBtn.addEventListener('click',close);
  if(window.matchMedia('(max-width:749px)').matches){var mini=function(){var y=window.scrollY;if(y>300)root.classList.add('is-mini');else if(y<150)root.classList.remove('is-mini');};window.addEventListener('scroll',mini,{passive:true});mini();}
  // Text is still inserted as text nodes (never innerHTML); only bare https URLs become links.
  function addMsg(text,who){
    var d=document.createElement('div');d.className='lc-asst__msg lc-asst__msg--'+who;
    var parts=String(text==null?'':text).split(/(https:\/\/[^\s<>"')]+)/);
    parts.forEach(function(p,i){
      if(i%2===1){var url=p.replace(/[.,;:!?]+$/,'');var a=document.createElement('a');a.href=url;a.textContent=url;a.target='_blank';a.rel='noopener';d.appendChild(a);if(url.length<p.length)d.appendChild(document.createTextNode(p.slice(url.length)));}
      else if(p){d.appendChild(document.createTextNode(p));}
    });
    body.appendChild(d);body.scrollTop=body.scrollHeight;return d;
  }
  function addCards(products){
    if(!products||!products.length)return;
    var wrap=document.createElement('div');wrap.className='lc-asst__cards';
    products.forEach(function(p){
      var a=document.createElement('a');a.className='lc-asst__card';a.href=p.url;a.target='_blank';a.rel='noopener';
      a.innerHTML='<img loading="lazy" src="'+esc(p.image||'')+'" alt="">'
        +'<div class="lc-asst__card-b"><div class="lc-asst__card-name">'+esc(p.name)+'</div>'
        +'<div class="lc-asst__card-price">'+esc(money(p.price))+'</div>'
        +(p.reason?'<div class="lc-asst__card-reason">'+esc(p.reason)+'</div>':'')+'</div>';
      wrap.appendChild(a);
    });
    body.appendChild(wrap);body.scrollTop=body.scrollHeight;
  }
  // ── "Ameublo décorateur": teaser (events to /api/teaser) until /api/visualiser reports decorateur:true ──
  var deco=root.querySelector('[data-lc-deco]');
  if(deco&&window.lcTeaser){
    var LT=window.lcTeaser, decoOn=false, decoSeen=false;
    LT.status().then(function(s){ decoOn=!!s.decorateur; if(decoOn) root.querySelector('[data-lc-deco-soon]').hidden=true; });
    fab.addEventListener('click',function(){ if(!decoSeen){ decoSeen=true; LT.log('decorateur','view','chat'); } });
    var bubble=function(text){ var d=addMsg(text,'bot'); return d; };
    var mk=function(tag,cls,txt){ var e=document.createElement(tag); if(cls)e.className=cls; if(txt!=null)e.textContent=txt; return e; };
    var D=LOC==='en'
      ?{ask:"Soon you'll be able to send me a photo of your room: I'll suggest pieces that match its style, and you'll even see them in your space. Would that interest you?",yes:'Yes, I would',no:'Not really',thanks:"Great! Want one email when it's ready?",mail:'Your email',ok:'Notify me',fine:'One email, at launch. No newsletter. You can unsubscribe at any time.',privacy:'Privacy',net:'That didn\'t go through. Please try again.',photoNote:'Your photo is processed by our AI provider (Google) to read the room; we don\'t keep it.',done:"Perfect, I'll write to you once, at launch.",noted:'Thanks, noted!',badMail:'Please check the email address.',live:'Send me a photo of your room (from the front, with good light) and I\'ll suggest pieces that suit it.',pick:'Choose a photo',reading:'Looking at your room…',notRoom:"That photo doesn't look like a room. Try a wider shot.",daily:"You've reached today's limit. Come back tomorrow!",busy:'I\'m very busy right now, please try again later.'}
      :{ask:"Bientôt, vous pourrez m'envoyer une photo de votre pièce : je vous suggérerai des meubles qui vont avec son style, et vous pourrez même les voir chez vous. Ça vous intéresserait ?",yes:"Oui, j'aimerais ça",no:'Pas vraiment',thanks:'Super ! Voulez-vous un courriel quand ce sera prêt ?',mail:'Votre courriel',ok:"M'avertir",fine:"Un seul courriel, au lancement. Pas d'infolettre. Vous pourrez vous désinscrire en tout temps.",privacy:'Confidentialité',net:"L'envoi n'a pas fonctionné. Réessayez.",photoNote:"Votre photo est traitée par notre fournisseur d'IA (Google) pour analyser la pièce ; nous ne la conservons pas.",done:"Parfait, je vous écrirai une seule fois, au lancement.",noted:"Merci, c'est noté !",badMail:"Vérifiez l'adresse courriel.",live:"Envoyez-moi une photo de votre pièce (de face, avec une bonne lumière) et je vous suggère des meubles qui vont avec.",pick:'Choisir une photo',reading:'Je regarde votre pièce…',notRoom:'Cette photo ne ressemble pas à une pièce. Essayez une vue plus large.',daily:'Vous avez atteint la limite pour aujourd\'hui. Revenez demain !',busy:'Je suis très occupé en ce moment, réessayez un peu plus tard.'};
    var askEmail=function(){
      var d=bubble(D.thanks), f=mk('form','lc-asst__row'), i=mk('input','lc-asst__mini-email'), b=mk('button','lc-asst__inline',D.ok);
      i.type='email'; i.autocomplete='email'; i.placeholder=D.mail; i.setAttribute('aria-label',D.mail); b.type='submit';
      // Same consent wording as CONSENT_TEXT (src/lib/teaser.ts), stored with the signup.
      var fine=mk('small','lc-asst__fine',D.fine+' '), pl=mk('a',null,D.privacy), say=mk('small','lc-asst__fine');
      pl.href=root.getAttribute('data-privacy')||'/policies/privacy-policy'; pl.target='_blank'; pl.rel='noopener'; fine.appendChild(pl);
      say.setAttribute('role','alert');
      f.appendChild(i); f.appendChild(b); d.appendChild(f); d.appendChild(fine); d.appendChild(say);
      f.addEventListener('submit',function(e){ e.preventDefault(); var v=i.value.trim();
        if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)){ i.setAttribute('aria-invalid','true'); say.textContent=D.badMail; i.focus(); return; }
        i.removeAttribute('aria-invalid'); say.textContent=''; b.disabled=true;
        LT.log('decorateur','email','chat',{email:v}).then(function(r){ if(!r||!r.ok) throw (r&&r.status===400?'bad':'net'); f.remove(); fine.remove(); say.remove(); bubble(D.done); })
          .catch(function(k){ b.disabled=false; i.setAttribute('aria-invalid','true'); say.textContent=k==='bad'?D.badMail:D.net; });
      });
      setTimeout(function(){ try{ i.focus({preventScroll:true}); }catch(e){} },30);
    };
    var liveDeco=function(){
      var d=bubble(D.live), row=mk('div','lc-asst__row'), lab=mk('label','lc-asst__inline',D.pick), inp=mk('input');
      inp.type='file'; inp.accept='image/*'; lab.appendChild(inp); row.appendChild(lab); d.appendChild(row);
      var note=mk('small','lc-asst__fine',D.photoNote+' '), nl=mk('a',null,D.privacy);
      nl.href=root.getAttribute('data-privacy')||'/policies/privacy-policy'; nl.target='_blank'; nl.rel='noopener'; note.appendChild(nl); d.appendChild(note);
      inp.addEventListener('change',function(){ var file=inp.files&&inp.files[0]; if(!file||busy) return; busy=true; send.disabled=true;
        var typing=addMsg(D.reading,'bot'); typing.classList.add('lc-asst__msg--typing'); pose(headMascot,'is-thinking');
        LT.shrink(file).then(function(p){ return fetch(LT.base+'/api/decorateur',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({photo:p.data,type:p.type,locale:LOC})}).then(function(r){ return r.json(); }); })
          .then(function(j){ typing.remove(); rest(headMascot);
            if(j&&j.success){ pose(headMascot,'is-happy',1100); if(j.reply){ addMsg(j.reply,'bot'); history.push({role:'assistant',content:j.reply}); } addCards(j.products); }
            else addMsg(j&&j.error==='not_room'?D.notRoom:j&&j.error==='daily'?D.daily:j&&j.error==='busy'?D.busy:T.err,'bot'); })
          .catch(function(){ typing.remove(); rest(headMascot); addMsg(T.err,'bot'); })
          .then(function(){ busy=false; send.disabled=false; inp.value=''; });
      });
    };
    deco.addEventListener('click',function(){
      if(busy) return;
      LT.log('decorateur','click','chat');
      addMsg(root.querySelector('[data-lc-deco-label]').textContent.trim(),'user');
      deco.hidden=true;
      if(decoOn) return liveDeco();
      var d=bubble(D.ask), row=mk('div','lc-asst__row'), y=mk('button','lc-asst__inline',D.yes), n=mk('button','lc-asst__inline lc-asst__inline--ghost',D.no);
      y.type=n.type='button'; row.appendChild(y); row.appendChild(n); d.appendChild(row);
      y.addEventListener('click',function(){ LT.log('decorateur','yes','chat'); row.remove(); askEmail(); });
      n.addEventListener('click',function(){ LT.log('decorateur','no','chat'); row.remove(); bubble(D.noted); });
    });
  }
  var chips=root.querySelector('[data-lc-asst-chips]');
  if(chips){chips.addEventListener('click',function(e){
    var b=e.target.closest('.lc-asst__chip'); if(!b||busy)return;
    input.value=b.textContent.trim(); chips.remove();
    if(form.requestSubmit){form.requestSubmit();}else{form.dispatchEvent(new Event('submit',{cancelable:true}));}
  });}
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=(input.value||'').trim(); if(!msg||busy)return;
    if(chips&&chips.parentNode)chips.remove();
    busy=true;send.disabled=true;
    addMsg(msg,'user'); input.value='';
    history.push({role:'user',content:msg});
    var typing=addMsg(T.typing,'bot');typing.classList.add('lc-asst__msg--typing');
    pose(headMascot,'is-thinking');
    fetch(API,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:msg,history:history.slice(-8),locale:LOC})})
      .then(function(r){return r.json();})
      .then(function(j){
        typing.remove();
        rest(headMascot);
        if(j&&j.success&&j.data){
          if(!j.data.limitReached)pose(headMascot,'is-happy',1100);
          var reply=j.data.reply||''; if(reply){addMsg(reply,'bot');history.push({role:'assistant',content:reply});}
          addCards(j.data.products);
        } else { addMsg(T.err,'bot'); }
      })
      .catch(function(){typing.remove();rest(headMascot);addMsg(T.err,'bot');})
      .finally(function(){busy=false;send.disabled=false;input.focus();});
  });
})();
</script>
