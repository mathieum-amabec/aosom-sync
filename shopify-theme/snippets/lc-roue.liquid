{%- comment -%}
  Roue de fortune de bienvenue (2026-10-19, v2 after Mat: "on se perd, pas assez d'emphase sur la roue").
  One spin per person, prize drawn by the SERVER (aosom-sync /api/roue), unique code valid 72 h, auto-applied through
  /discount/CODE. Slice sizes = the real odds (45/30/17/7/1 %).
  Steps, one task each: 1) email (+ OPTIONAL email-marketing box — CASL forbids making it a condition of playing);
  2) skill-testing question (Criminal Code s.206), re-checked by the server; 3) spin, prize, code, countdown.
  Desktop: opens itself once after 20 s, 50 % scroll or exit intent. Phone: opens itself once only on the home and
  collection pages (never over a product page), after 25 s or 60 % scroll; everywhere else a small tab on the left edge.
  Never on cart/account. Kill switch: settings.roue_enabled = "0" on the server (also closed after ROUE_ENDS_AT).
  CLOSING DATE: 31 janvier 2027 — keep it equal to ROUE_ENDS_AT in aosom-sync src/lib/welcome-wheel.ts.
{%- endcomment -%}
{%- assign loc = request.locale.iso_code | downcase -%}
{%- liquid
  assign roue_show = true
  if request.page_type == 'cart' or request.page_type == 'captcha' or request.page_type == 'password'
    assign roue_show = false
  endif
  if request.page_type contains 'customers'
    assign roue_show = false
  endif
-%}
{%- if roue_show -%}
<div id="lc-roue" class="lc-roue" data-loc="{{ loc }}" data-page="{{ request.page_type }}" hidden>
  <button type="button" class="lc-roue__tab" data-roue-open aria-haspopup="dialog">
    <svg class="lc-roue__tab-ico" viewBox="-12 -12 24 24" aria-hidden="true"><circle r="11.5" fill="#F2C14E"/><path d="M0 0L0-10A10 10 0 0 1 9.5-3.1Z" fill="#1B2A4A"/><path d="M0 0L9.5-3.1A10 10 0 0 1 5.9 8.1Z" fill="#B8553C"/><path d="M0 0L5.9 8.1A10 10 0 0 1-5.9 8.1Z" fill="#2F6B5E"/><path d="M0 0L-5.9 8.1A10 10 0 0 1-9.5-3.1Z" fill="#1B2A4A"/><path d="M0 0L-9.5-3.1A10 10 0 0 1 0-10Z" fill="#B8553C"/><circle r="3" fill="#fff"/></svg>
    <span class="lc-roue__tab-txt">{% if loc == 'en' %}Spin &amp; win{% else %}Roue de fortune{% endif %}</span>
  </button>
  <div class="lc-roue__dlg" role="dialog" aria-modal="true" aria-labelledby="lc-roue-title" hidden>
    <span class="lc-roue__ov" data-roue-close></span>
    <div class="lc-roue__card">
      <button type="button" class="lc-roue__x" data-roue-close aria-label="{% if loc == 'en' %}Close{% else %}Fermer{% endif %}">&times;</button>
      <div class="lc-roue__wheelbox">
        <p class="lc-roue__kicker">{% if loc == 'en' %}Wheel of fortune · every spin wins{% else %}Roue de fortune · chaque tour gagne{% endif %}</p>
        <div class="lc-roue__wheelwrap">
          <span class="lc-roue__pin" aria-hidden="true"></span>
          <svg class="lc-roue__wheel" viewBox="-112 -112 224 224" aria-hidden="true"></svg>
          <div class="lc-roue__hub" aria-hidden="true">{% if loc == 'en' %}SPIN{% else %}TOURNE{% endif %}</div>
        </div>
      </div>
      <div class="lc-roue__body">
        <div class="lc-roue__s1">
          <h2 id="lc-roue-title" class="lc-roue__title">{% if loc == 'en' %}Spin the wheel, win up to <span>$100 off</span>{% else %}Tourne la roue, gagne jusqu'à <span>100&nbsp;$ de rabais</span>{% endif %}</h2>
          <p class="lc-roue__oddsline"></p>
          <form class="lc-roue__form" novalidate>
            <div class="lc-roue__step" data-step="1">
              <input class="lc-roue__email" type="email" name="email" required autocomplete="email" inputmode="email" placeholder="{% if loc == 'en' %}Your email to play{% else %}Ton courriel pour jouer{% endif %}" aria-label="{% if loc == 'en' %}Email{% else %}Courriel{% endif %}">
              <input class="lc-roue__hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
              <button class="lc-roue__btn" type="submit">{% if loc == 'en' %}Spin the wheel{% else %}Tourner la roue{% endif %}</button>
              <label class="lc-roue__consent"><input type="checkbox" name="consent"> <span>{% if loc == 'en' %}Also email me my code, a reminder and Furnish Direct deals (optional). Unsubscribe anytime. <a href="/en/policies/privacy-policy" target="_blank" rel="noopener">Privacy</a>{% else %}Envoyez-moi aussi mon code, un rappel et les rabais d'Ameublo Direct par courriel (facultatif). Désabonnement en tout temps. <a href="/policies/privacy-policy" target="_blank" rel="noopener">Confidentialité</a>{% endif %}</span></label>
            </div>
            <div class="lc-roue__step" data-step="2" hidden>
              <p class="lc-roue__qlead" id="lc-roue-qlead">{% if loc == 'en' %}Last step! The law requires a skill-testing question:{% else %}Dernière étape&nbsp;! La loi exige une question d'habileté&nbsp;:{% endif %}</p>
              <label class="lc-roue__skill"><b class="lc-roue__q" id="lc-roue-q"></b> =<input type="text" name="skill" inputmode="numeric" autocomplete="off" maxlength="4" aria-labelledby="lc-roue-qlead lc-roue-q"></label>
              <button class="lc-roue__btn" type="submit">{% if loc == 'en' %}Spin!{% else %}Lancer la roue&nbsp;!{% endif %}</button>
              <button type="button" class="lc-roue__back">{% if loc == 'en' %}← Change email{% else %}← Changer de courriel{% endif %}</button>
            </div>
            <p class="lc-roue__msg" role="alert" hidden></p>
          </form>
        </div>
        <div class="lc-roue__s2" hidden>
          <p class="lc-roue__won">{% if loc == 'en' %}🎉 You won{% else %}🎉 Tu as gagné{% endif %}</p>
          <p class="lc-roue__prize"></p>
          <button type="button" class="lc-roue__code" data-roue-copy title="{% if loc == 'en' %}Copy{% else %}Copier{% endif %}"></button>
          <p class="lc-roue__applied">{% if loc == 'en' %}✓ Applied automatically at checkout{% else %}✓ Appliqué automatiquement à la caisse{% endif %}<span class="lc-roue__mailed">{% if loc == 'en' %} · also sent by email{% else %} · aussi envoyé par courriel{% endif %}</span></p>
          <p class="lc-roue__note" hidden>{% if loc == 'en' %}Write down your code: it is not sent by email.{% else %}Note ton code&nbsp;: il ne t'est pas envoyé par courriel.{% endif %}</p>
          <p class="lc-roue__timer" aria-live="off"></p>
          <a class="lc-roue__btn lc-roue__shop" href="{% if loc == 'en' %}/en/collections/all{% else %}/collections/all{% endif %}">{% if loc == 'en' %}Shop now{% else %}Magasiner maintenant{% endif %}</a>
        </div>
        <details class="lc-roue__rules">
          <summary>{% if loc == 'en' %}No purchase necessary · Canada, 18+ · Skill-testing question · Ends Jan. 31, 2027 · <u>Odds and rules</u>{% else %}Aucun achat requis · Canada, 18 ans+ · Question d'habileté · Fin le 31 janvier 2027 · <u>Chances et règlement</u>{% endif %}</summary>
          <ul class="lc-roue__odds"></ul>
          <p>{% if loc == 'en' %}Organizer: Furnish Direct (Ameublo Direct), Saint-Hubert, QC — info@ameublodirect.ca. Open to residents of Canada aged 18 or older, from October 2026 until January 31, 2027, 11:59 p.m. (ET). No purchase necessary: entering only requires an email address and the correct answer to a mathematical skill-testing question. One spin per person (one email). Every spin wins one of the prizes above, at the odds shown; the number of prizes is unlimited. Each prize is a single-use discount code, valid 72 h after the spin, on the subtotal before taxes and shipping once the minimum is reached; not combinable with other discounts (the 2nd-item discount included); no cash value, not exchangeable. Receiving emails is optional and does not change your chances. Your email is used to run the game and, only if you ticked the box, to send you our emails (<a href="/en/policies/privacy-policy" target="_blank" rel="noopener">privacy policy</a>).{% else %}Organisateur&nbsp;: Ameublo Direct, Saint-Hubert, QC — info@ameublodirect.ca. Ouvert aux résidents du Canada de 18 ans et plus, d'octobre 2026 au 31 janvier 2027, 23 h 59 (HE). Aucun achat requis&nbsp;: pour participer, il suffit d'un courriel et de la bonne réponse à une question d'habileté mathématique. Un tour par personne (un courriel). Chaque tour gagne un des prix ci-dessus, selon les chances indiquées; le nombre de prix est illimité. Chaque prix est un code de rabais à usage unique, valide 72&nbsp;h après le tour, sur le sous-total avant taxes et livraison une fois le minimum atteint; non cumulable avec les autres rabais (dont le rabais du 2e article); aucune valeur monétaire, non échangeable. Recevoir nos courriels est facultatif et ne change pas tes chances. Ton courriel sert à faire fonctionner le jeu et, seulement si tu as coché la case, à t'envoyer nos courriels (<a href="/policies/privacy-policy" target="_blank" rel="noopener">politique de confidentialité</a>).{% endif %}</p>
        </details>
      </div>
    </div>
  </div>
</div>
<style>
.lc-roue{font-family:var(--lc-font-text,Arial,sans-serif);color:var(--lc-navy,#1B2A4A)}
.lc-roue__tab{position:fixed;left:max(14px,env(safe-area-inset-left,0px));bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:9990;display:flex;align-items:center;gap:8px;padding:9px 16px 9px 10px;border:0;border-radius:999px;background:var(--lc-navy,#1B2A4A);color:#fff;font:700 14px/1.1 var(--lc-font-text,Arial,sans-serif);box-shadow:0 6px 18px rgba(27,42,74,.3);cursor:pointer}
.lc-roue__tab-ico{width:26px;height:26px;flex:none;animation:lc-roue-tab 6s linear infinite}
@keyframes lc-roue-tab{to{transform:rotate(360deg)}}
.lc-roue__tab-txt{white-space:pre-line}
.lc-roue__tab:hover{background:var(--lc-terra,#B8553C)}
.lc-roue.is-won .lc-roue__tab{background:var(--lc-terra-btn,#B8553C)}
.lc-roue.is-won .lc-roue__tab-ico{animation:none}
body:has(.sticky-atc.is-visible) .lc-roue__tab{bottom:calc(78px + env(safe-area-inset-bottom,0px))}
/* Phone: the bottom corners belong to the assistant (left) and Messenger (right), so the wheel is a small tab on the
   left edge instead. */
@media(max-width:749px){
  .lc-roue__tab,body:has(.sticky-atc.is-visible) .lc-roue__tab{left:0;bottom:auto;top:56%;flex-direction:column;gap:4px;width:62px;padding:9px 4px 8px;border-radius:0 14px 14px 0;font-size:11px;line-height:1.15;text-align:center}
  .lc-roue__tab-ico{width:30px;height:30px}
}
.lc-roue__dlg{position:fixed;inset:0;z-index:100000;display:flex;align-items:center;justify-content:center;padding:16px}
.lc-roue__dlg[hidden]{display:none}
/* Pin and overlay are spans: the theme hides every empty div (div:empty{display:none}). */
.lc-roue__ov{display:block;position:absolute;inset:0;background:rgba(26,26,46,.6)}
.lc-roue__card{position:relative;width:100%;max-width:400px;max-height:calc(100dvh - 32px);overflow:auto;background:#fff;border-radius:24px;box-shadow:0 20px 60px rgba(0,0,0,.35);animation:lc-roue-in .3s ease both}
@keyframes lc-roue-in{from{opacity:0;transform:translateY(14px) scale(.98)}to{opacity:1;transform:none}}
.lc-roue__x{position:absolute;top:4px;right:6px;z-index:3;width:44px;height:44px;border:0;background:none;font-size:30px;line-height:1;color:#fff;cursor:pointer}
.lc-roue__wheelbox{background:radial-gradient(circle at 50% 60%,#2a3d66 0%,var(--lc-navy,#1B2A4A) 70%);padding:14px 0 16px;text-align:center}
.lc-roue__kicker{margin:0 48px 8px;font:800 12px/1.2 var(--lc-font-text,Arial,sans-serif);letter-spacing:.12em;text-transform:uppercase;color:var(--lc-sun,#F2C14E)}
.lc-roue__wheelwrap{position:relative;width:min(250px,62vw);margin:0 auto}
.lc-roue__wheel{width:100%;height:auto;display:block;border-radius:50%;filter:drop-shadow(0 8px 18px rgba(0,0,0,.45));will-change:transform}
.lc-roue__pin{display:block;position:absolute;top:-8px;left:50%;transform:translateX(-50%);z-index:2;width:0;height:0;border-left:15px solid transparent;border-right:15px solid transparent;border-top:30px solid var(--lc-sun,#F2C14E);filter:drop-shadow(0 3px 3px rgba(0,0,0,.5))}
.lc-roue__hub{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:58px;height:58px;border-radius:50%;background:#fff;border:3px solid var(--lc-sun,#F2C14E);color:var(--lc-navy,#1B2A4A);font:900 11px/52px var(--lc-font-text,Arial,sans-serif);letter-spacing:.04em;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.35)}
.lc-roue__body{padding:16px 22px 18px;text-align:center}
.lc-roue__oddsline{margin:-6px 0 12px;font-size:11.5px;line-height:1.4;color:#6b7080}
.lc-roue__back{align-self:center;padding:4px 8px;border:0;background:none;font-size:12.5px;color:#5b6172;text-decoration:underline;cursor:pointer}
.lc-roue__title{margin:0 0 12px;font:600 21px/1.25 var(--lc-font-display,Georgia,serif);color:var(--lc-navy,#1B2A4A);text-wrap:balance}
.lc-roue__title span{color:var(--lc-terra-btn,#B8553C);white-space:nowrap}
.lc-roue__form{text-align:left}
.lc-roue__step{display:flex;flex-direction:column;gap:10px}
.lc-roue__step[hidden]{display:none}
.lc-roue__email{padding:13px 16px;border:1.5px solid #d9d2c7;border-radius:999px;font:16px var(--lc-font-text,Arial,sans-serif)}
.lc-roue__email:focus,.lc-roue__skill input:focus{outline:2px solid var(--lc-terra,#B8553C);border-color:var(--lc-terra,#B8553C)}
.lc-roue__hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
.lc-roue__consent{display:flex;gap:8px;align-items:flex-start;font-size:12px;line-height:1.4;color:#5b6172;cursor:pointer}
.lc-roue__consent input{margin:1px 0 0;width:18px;height:18px;flex:none;accent-color:var(--lc-navy,#1B2A4A)}
.lc-roue__consent a,.lc-roue__rules a{color:inherit}
.lc-roue__qlead{margin:0;font-size:14px;line-height:1.4;color:#4a4f5c;text-align:center}
.lc-roue__skill{display:flex;align-items:center;justify-content:center;gap:10px;font:800 26px var(--lc-font-text,Arial,sans-serif);color:var(--lc-navy,#1B2A4A)}
.lc-roue__skill b{white-space:nowrap}
.lc-roue__skill input{width:84px;padding:8px 10px;border:1.5px solid #d9d2c7;border-radius:12px;font:800 24px var(--lc-font-text,Arial,sans-serif);text-align:center;color:var(--lc-navy,#1B2A4A)}
.lc-roue__btn{display:block;width:100%;padding:15px;border:0;border-radius:999px;background:var(--lc-terra-btn,#B8553C);color:#fff;font:800 17px var(--lc-font-text,Arial,sans-serif);text-align:center;text-decoration:none;cursor:pointer;box-shadow:0 4px 0 #8f3f2b}
.lc-roue__btn:hover{background:var(--lc-navy,#1B2A4A);color:#fff;box-shadow:0 4px 0 #0f1a30}
.lc-roue__btn:disabled{opacity:.7;cursor:default}
.lc-roue__msg{margin:10px 0 0;font-size:13px;color:#b3261e;text-align:center}
.lc-roue__won{margin:0;font-size:15px;color:#4a4f5c}
.lc-roue__prize{margin:2px 0 10px;font:700 28px/1.15 var(--lc-font-display,Georgia,serif);color:var(--lc-navy,#1B2A4A)}
.lc-roue__code{display:inline-block;padding:10px 20px;border:2px dashed var(--lc-terra-btn,#B8553C);border-radius:12px;background:#fff;font:800 22px var(--lc-font-text,Arial,sans-serif);letter-spacing:.08em;color:var(--lc-navy,#1B2A4A);cursor:copy;user-select:all}
.lc-roue__applied{margin:10px 0 2px;font-size:13px;color:#2e7d4f;font-weight:600}
.lc-roue__note{margin:4px 0 0;font-size:13px;color:#b3261e;font-weight:600}
.lc-roue__timer{margin:4px 0 14px;font-size:13px;color:#4a4f5c;font-variant-numeric:tabular-nums}
.lc-roue__rules{margin-top:12px;text-align:left;font-size:11px;line-height:1.45;color:#6b7080}
.lc-roue__rules summary{cursor:pointer;text-align:center;list-style:none}
.lc-roue__rules summary::-webkit-details-marker{display:none}
.lc-roue__odds{margin:8px 0;padding-left:18px}
@media(max-width:749px){.lc-roue__wheelwrap{width:min(210px,56vw)}.lc-roue__title{font-size:19px}.lc-roue__kicker{margin:0 40px 8px;font-size:10.5px;letter-spacing:.06em}.lc-roue__hub{font-size:10px}}
@media(max-height:640px){.lc-roue__wheelwrap{width:170px}}
@media(prefers-reduced-motion:reduce){.lc-roue__card,.lc-roue__tab-ico{animation:none}}
</style>
<script>
(function(){
  var root=document.getElementById('lc-roue'); if(!root) return;
  var EN=root.getAttribute('data-loc')==='en', PAGE=root.getAttribute('data-page')||'';
  var API='https://aosom-sync.vercel.app/api/roue', KEY='lc_roue_v1';
  // Same order and weights as WHEEL_PRIZES in aosom-sync src/lib/welcome-wheel.ts — the server sends back the index.
  var P=[{a:15,m:150,w:45,c:'#1B2A4A'},{a:25,m:250,w:30,c:'#B8553C'},{a:40,m:400,w:17,c:'#2F6B5E'},{a:60,m:600,w:7,c:'#F2C14E',t:'#1B2A4A'},{a:100,m:1000,w:1,c:'#FBF7F1',t:'#1B2A4A'}];
  function money(n){return EN?('$'+n.toLocaleString('en-CA')):(n.toLocaleString('fr-CA')+' $');}
  function label(p){return EN?(money(p.a)+' off '+money(p.m)+'+'):(money(p.a)+' dès '+money(p.m));}
  var st={}; try{st=JSON.parse(localStorage.getItem(KEY)||'{}')||{};}catch(e){}
  function save(){try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}}
  if(st.off && Date.now()-st.off<864e5) return; // kill switch seen less than 24 h ago
  if(st.played) return; // played on another device
  if(st.code && st.exp && Date.parse(st.exp)<Date.now()) return; // expired: nothing more to show
  // Ask the server first (edge-cached GET): with the kill switch on, nothing appears at all.
  fetch(API,{method:'GET'}).then(function(r){return r.json();}).then(function(j){ if(j&&j.enabled) start(); else { st.off=Date.now(); save(); } }).catch(function(){});
  function start(){
  root.hidden=false;
  var dlg=root.querySelector('.lc-roue__dlg'), tabTxt=root.querySelector('.lc-roue__tab-txt');
  var svg=root.querySelector('.lc-roue__wheel'), s1=root.querySelector('.lc-roue__s1'), s2=root.querySelector('.lc-roue__s2');
  var form=root.querySelector('.lc-roue__form'), msg=root.querySelector('.lc-roue__msg');
  var step1=form.querySelector('[data-step="1"]'), step2=form.querySelector('[data-step="2"]');
  var btn1=step1.querySelector('.lc-roue__btn'), btn2=step2.querySelector('.lc-roue__btn');
  var reduce=window.matchMedia('(prefers-reduced-motion:reduce)').matches;

  // Wheel: gold rim with light bulbs, slice i spans its weight in degrees, clockwise from 12 o'clock.
  var NS='http://www.w3.org/2000/svg', total=0, spans=[]; P.forEach(function(p){total+=p.w;});
  function el(tag,attrs){var e=document.createElementNS(NS,tag); for(var k in attrs) e.setAttribute(k,attrs[k]); return e;}
  svg.appendChild(el('circle',{r:111,fill:'#F2C14E'}));
  svg.appendChild(el('circle',{r:101,fill:'#d9a632'}));
  var acc=0; P.forEach(function(p){var a0=acc/total*360; acc+=p.w; spans.push([a0,acc/total*360]);});
  function pt(r,deg){var t=(deg-90)*Math.PI/180;return [r*Math.cos(t),r*Math.sin(t)];}
  P.forEach(function(p,i){
    var a0=spans[i][0],a1=spans[i][1],s=pt(99,a0),e=pt(99,a1),large=(a1-a0)>180?1:0;
    svg.appendChild(el('path',{d:'M0 0 L'+s[0].toFixed(2)+' '+s[1].toFixed(2)+' A99 99 0 '+large+' 1 '+e[0].toFixed(2)+' '+e[1].toFixed(2)+' Z',fill:p.c,stroke:'#fff','stroke-width':'1.2'}));
    var span=a1-a0; if(span<14) return; // a 1 % slice is too thin to label; the odds list names it
    var g=el('g',{transform:'rotate('+((a0+a1)/2)+')'});
    var t1=el('text',{x:0,y:-64,'text-anchor':'middle',fill:p.t||'#fff','font-size':span>40?'18':'13','font-weight':'800','font-family':'Arial,sans-serif'}); t1.textContent=money(p.a); g.appendChild(t1);
    if(span>40){var t2=el('text',{x:0,y:-48,'text-anchor':'middle',fill:p.t||'#fff','font-size':'9.5','font-family':'Arial,sans-serif'}); t2.textContent=(EN?'on ':'dès ')+money(p.m); g.appendChild(t2);}
    svg.appendChild(g);
  });
  var bulbs=[]; for(var b=0;b<18;b++){ var q=pt(106,b*20); var c=el('circle',{cx:q[0].toFixed(2),cy:q[1].toFixed(2),r:3.2,fill:b%2?'#fff':'#fff6d6'}); bulbs.push(c); svg.appendChild(c); }
  var odds=root.querySelector('.lc-roue__odds');
  P.forEach(function(p){var li=document.createElement('li'); li.textContent=label(p)+' — '+(EN?'odds ':'chances ')+p.w+' %'; odds.appendChild(li);});
  // Odds in plain sight under the "up to $100" headline (Competition Act: the 1 % prize must not mislead).
  root.querySelector('.lc-roue__oddsline').textContent=(EN?'Odds: ':'Chances : ')+P.map(function(p){return (money(p.a)+' '+p.w+' %').replace(/\s/g,' ');}).join(' · ')+(EN?' — minimum order 10× the discount':' — achat minimum 10× le rabais');

  // Bulbs twinkle while the dialog is open (marquee look); off with reduced motion.
  var blink=0, blinkT=0;
  function twinkle(on){ clearInterval(blinkT); if(!on||reduce) return; blinkT=setInterval(function(){ blink^=1; bulbs.forEach(function(c,i){ c.setAttribute('fill',(i%2)===blink?'#ffffff':'#ffe08a'); c.setAttribute('opacity',(i%2)===blink?'1':'.55'); }); },450); }

  var lastFocus=null;
  function open(){ if(!dlg.hidden) return; lastFocus=document.activeElement; dlg.hidden=false; st.seen=1; save(); document.documentElement.style.overflow='hidden'; twinkle(true); idle(true);
    var f=st.code?root.querySelector('.lc-roue__shop'):form.querySelector('.lc-roue__email'); setTimeout(function(){try{f.focus({preventScroll:true});}catch(e){}},50); }
  function close(){ dlg.hidden=true; document.documentElement.style.overflow=''; twinkle(false); idle(false); if(lastFocus&&lastFocus.focus) try{lastFocus.focus();}catch(e){} }
  root.addEventListener('click',function(e){ if(e.target.closest('[data-roue-open]')) open(); else if(e.target.closest('[data-roue-close]')) close(); });
  document.addEventListener('keydown',function(e){
    if(dlg.hidden) return;
    if(e.key==='Escape') return close();
    if(e.key!=='Tab') return; // keep focus inside the dialog
    var f=[].filter.call(dlg.querySelectorAll('button,input,a[href],summary'),function(x){return x.offsetParent!==null&&!x.disabled;});
    if(!f.length) return; var first=f[0], last=f[f.length-1];
    if(e.shiftKey&&document.activeElement===first){ e.preventDefault(); last.focus(); } else if(!e.shiftKey&&document.activeElement===last){ e.preventDefault(); first.focus(); } });

  // Countdown on the tab and in the dialog once a code exists.
  function left(){var ms=Date.parse(st.exp)-Date.now(); if(!(ms>0)) return null; var h=Math.floor(ms/3600000), m=Math.floor(ms%3600000/60000), s=Math.floor(ms%60000/1000);
    return {h:h,m:m,s:s,txt:h+' h '+(m<10?'0':'')+m+(h<1?' min '+(s<10?'0':'')+s+' s':'')};}
  function showWon(){ root.classList.add('is-won'); s1.hidden=true; s2.hidden=false;
    var p=P[st.i]; root.querySelector('.lc-roue__prize').textContent=label(p); root.querySelector('.lc-roue__code').textContent=st.code;
    root.querySelector('.lc-roue__mailed').hidden=!st.mail; root.querySelector('.lc-roue__note').hidden=!!st.mail; tick(); }
  function tick(){ if(!st.code) return; var l=left();
    if(!l){ root.hidden=true; return; }
    tabTxt.textContent=money(P[st.i].a)+(window.matchMedia('(max-width:749px)').matches?'\n':' · ')+l.txt;
    root.querySelector('.lc-roue__timer').textContent=(EN?'Expires in ':'Expire dans ')+l.txt; }
  if(st.code){ showWon(); setInterval(tick,1000); }

  root.querySelector('[data-roue-copy]').addEventListener('click',function(){ var c=st.code; if(!c) return;
    if(navigator.clipboard) navigator.clipboard.writeText(c).then(function(){ var b=root.querySelector('.lc-roue__code'); b.textContent=EN?'Copied!':'Copié!'; setTimeout(function(){b.textContent=c;},1200); }).catch(function(){}); });

  // Spin: slow idle turn while open (shows it is a wheel), fast free-wheel while the server draws, then ease onto the
  // slice the server returns.
  var angle=0, raf=0, speed=0, mode='';
  function setRot(a){ svg.style.transform='rotate('+a+'deg)'; }
  function loop(){ var last=performance.now(); cancelAnimationFrame(raf); (function f(t){ angle+=(t-last)*speed; last=t; setRot(angle); if(mode) raf=requestAnimationFrame(f); })(last); }
  function idle(on){ if(st.code||mode==='fast') return; if(on&&!reduce){ mode='idle'; speed=0.012; loop(); } else { mode=''; cancelAnimationFrame(raf); } }
  function freeSpin(){ if(reduce) return; mode='fast'; speed=0.6; loop(); }
  function landOn(i,done){ mode=''; cancelAnimationFrame(raf);
    var a0=spans[i][0],a1=spans[i][1],w=a1-a0, target=(a0+a1)/2+(Math.random()-.5)*w*.6; // a random point inside the slice
    var end=angle+(reduce?0:360*5)+((360-((target+angle)%360))%360), start=angle, t0=performance.now(), D=reduce?400:4200;
    (function f(t){ var k=Math.min(1,(t-t0)/D), e=1-Math.pow(1-k,4); angle=start+(end-start)*e; setRot(angle); if(k<1) requestAnimationFrame(f); else done(); })(t0); }
  function stopFast(){ if(mode==='fast'){ mode=''; cancelAnimationFrame(raf); if(!dlg.hidden) idle(true); } }
  var busy=false; // one request at a time: Enter in step 2 can submit again during the 4 s landing
  function fail(text){ busy=false; stopFast(); btn1.disabled=false; btn2.disabled=false; msg.hidden=false; msg.textContent=text; }

  // Skill-testing question (required by law for a prize drawn by chance): a + b × c, re-checked by the server.
  var Q={}; function rnd(lo,hi){return lo+Math.floor(Math.random()*(hi-lo+1));}
  function newQ(){ Q={a:rnd(2,9),b:rnd(2,6),c:rnd(2,5)}; root.querySelector('.lc-roue__q').textContent=Q.a+' + '+Q.b+' × '+Q.c; form.skill.value=''; }
  newQ();
  var BAD_Q=EN?'Not quite (multiplication first). Try this one.':'Pas tout à fait (la multiplication d’abord). Essaie celle-ci.';
  function toStep2(){ step1.hidden=true; step2.hidden=false; setTimeout(function(){try{form.skill.focus({preventScroll:true});}catch(e){}},30); }
  function toStep1(){ step2.hidden=true; step1.hidden=false; }
  root.querySelector('.lc-roue__back').addEventListener('click',function(){ if(busy) return; msg.hidden=true; toStep1(); try{form.email.focus();}catch(e){} });

  form.addEventListener('submit',function(e){ e.preventDefault(); if(busy) return; msg.hidden=true;
    var email=(form.email.value||'').trim();
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)){ toStep1(); return fail(EN?'Please enter a valid email.':'Entre un courriel valide.'); }
    if(step2.hidden) return toStep2();
    var ans=(form.skill.value||'').trim();
    if(!ans) return fail(EN?'Answer the question to spin.':'Réponds à la question pour tourner.');
    if(Number(ans)!==Q.a+Q.b*Q.c){ newQ(); return fail(BAD_Q); }
    var consent=!!form.consent.checked;
    busy=true; btn1.disabled=true; btn2.disabled=true; freeSpin();
    fetch(API,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email,consent:consent,locale:EN?'en':'fr',website:form.website.value,skill:{a:Q.a,b:Q.b,c:Q.c,answer:ans}})})
      .then(function(r){return r.json().then(function(j){return {s:r.status,j:j};});})
      .then(function(x){ var j=x.j||{};
        if(j.success&&j.already&&j.prize&&!j.code){ // this email already played: the server never re-sends the code
          st={played:1,seen:1}; save(); toStep1();
          return fail(EN?('This email already played and won '+label(P[j.prize.index])+'. One spin per person.'):('Ce courriel a déjà joué et gagné '+label(P[j.prize.index])+'. Un tour par personne.'));
        }
        if(x.s===400&&j.error==='skill'){ newQ(); return fail(BAD_Q); }
        if(!j.success||!j.code||!j.prize) {
          if(x.s===503){ st.off=Date.now(); save(); setTimeout(function(){ close(); root.hidden=true; },2500); }
          return fail(x.s===429?(EN?'Too many tries, please come back later.':'Trop d’essais, reviens un peu plus tard.'):(x.s===409?(EN?'One moment, try again.':'Un instant, réessaie.'):(EN?'Oops, the wheel is stuck. Try again in a moment.':'Oups, la roue est coincée. Réessaie dans un instant.')));
        }
        st={i:j.prize.index,code:j.code,exp:j.expiresAt,seen:1,mail:consent?1:0}; save();
        try{ fetch('/discount/'+encodeURIComponent(j.code),{credentials:'same-origin'}); }catch(e){}
        // Klaviyo only with consent: identifying a visitor who said no could pull them into other flows.
        try{ if(consent&&window.klaviyo) window.klaviyo.push(['identify',{'$email':email}]); }catch(e){}
        try{ if(window.fbq) window.fbq('track','Lead',{content_name:'Roue de bienvenue'}); }catch(e){}
        var go=function(){ twinkle(true); showWon(); setInterval(tick,1000); try{root.querySelector('.lc-roue__code').focus({preventScroll:true});}catch(e){} };
        if(j.already){ stopFast(); go(); } else landOn(j.prize.index,go);
      })
      .catch(function(){ fail(EN?'Connection problem. Try again.':'Problème de connexion. Réessaie.'); });
  });

  // When it opens by itself: once per visitor, never over a product page on a phone.
  if(st.seen||st.code) return;
  var phone=window.matchMedia('(max-width:749px)').matches;
  if(phone && PAGE!=='index' && PAGE!=='collection' && PAGE!=='list-collections') return;
  var t0=Date.now(), fired=false;
  function auto(){ if(fired||st.seen||st.code) return; fired=true; window.removeEventListener('scroll',onScroll); document.removeEventListener('mouseout',onOut); open(); }
  function onScroll(){ var h=document.documentElement.scrollHeight-innerHeight; if(h>0&&(scrollY/h)>=(phone?.6:.5)&&Date.now()-t0>=8000) auto(); }
  function onOut(e){ if(!e.relatedTarget&&e.clientY<=0&&Date.now()-t0>=5000) auto(); }
  setTimeout(auto,phone?25000:20000);
  window.addEventListener('scroll',onScroll,{passive:true});
  if(!phone) document.addEventListener('mouseout',onOut);
  }
})();
</script>
{%- endif -%}
