{%- comment -%}
  agentic-faq.liquid — FAQPage JSON-LD only (2026-10-15 UX pass).

  The visible answers now live in ONE accordion list with the store info (templates/product.json,
  block `pdp_info`): Livraison, Retours, Garantie, Montage, Entretien, Paiement sécurisé. Before,
  this snippet rendered its own "Questions fréquentes" list in a different font right above that
  list, and Livraison / Retours were said twice. The markup below reuses the SAME locale strings
  (faq.a2…a5) that pdp_info shows, so the structured data still matches visible content.
  q1 (dimensions) is dropped: its answer only pointed at the description.

  Usage : {% render 'agentic-faq', product: product %}
{%- endcomment -%}
{%- comment -%}
  GEO 2026-10-18 : le filtre `t` échappe l'HTML (d'idée → d&#39;idée). Le JSON-LD n'est pas décodé
  par les robots, donc on remet les caractères avant `json` (&amp; en dernier).
{%- endcomment -%}
{%- liquid
  assign q2 = 'faq.q2' | t | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  assign a2 = 'faq.a2' | t | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  assign q3 = 'faq.q3' | t | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  assign a3 = 'faq.a3' | t | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  assign q4 = 'faq.q4' | t | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  assign a4 = 'faq.a4' | t | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  assign q5 = 'faq.q5' | t | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  assign a5 = 'faq.a5' | t | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": {{ q2 | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ a2 | json }} } },
    { "@type": "Question", "name": {{ q5 | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ a5 | json }} } },
    { "@type": "Question", "name": {{ q4 | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ a4 | json }} } },
    { "@type": "Question", "name": {{ q3 | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ a3 | json }} } }
  ]
}
</script>
