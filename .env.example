# Shopify Admin API
SHOPIFY_ACCESS_TOKEN=

# Claude API for content generation
ANTHROPIC_API_KEY=

# Cron secret (for scheduled sync endpoint)
CRON_SECRET=

# Session-token signing key — MUST be high-entropy and DISTINCT from AUTH_PASSWORD.
# Signs the dashboard session cookie (HMAC-SHA256). Keeping it separate from the human
# login password prevents any issued token from being an offline cracking oracle for
# the admin secret. If unset, session signing falls back to AUTH_PASSWORD (the old, weak
# behavior) — set this to activate the fix. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Simple auth password for the 2 users (seeds the "admin" user on first login).
# Also serves as the DB-independent emergency admin login: if Turso is down/over
# quota, logging in as "admin" with this password still works (no DB lookup).
AUTH_PASSWORD=

# Meta App Review reviewer account. Seeds a "meta-review" user with the
# "reviewer" role, which can only access /social and /settings. Revoke after
# Meta approves the app by removing this env var and deleting the user row.
META_REVIEW_PASSWORD=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=  # Meta Business Suite → Events Manager. When unset, the injected ScriptTag is a no-op.

# Pinterest Tag
PINTEREST_TAG_ID=  # Pinterest Ads Manager → Conversions → the tag (numeric). When unset, the injected ScriptTag is a no-op. Read server-side by /api/pixel/pinterest-script.

# Vercel Blob — durable storage for generated videos (and sync-run blobs).
# Vercel dashboard → Storage → Blob store → Read/Write Token. When unset, the
# video pipeline skips the upload and serves renders from the local filesystem.
BLOB_READ_WRITE_TOKEN=

# ─── Google Ads API ────────────────────────────────────────────────────────────
# Powers src/lib/google-ads-client.ts and scripts/create-google-shopping-campaign.mts.
# The scripts DRY-RUN without any of these; only --apply requires them.
# Full provisioning walkthrough: docs/GOOGLE-ADS-SETUP.md

# Developer token — the header Google Ads requires on top of OAuth.
# Where: ads.google.com → Tools & Settings (wrench) → Setup → API Center.
# API Center only appears on a MANAGER (MCC) account. If the account isn't under an
# MCC, create a free manager account at ads.google.com/home/tools/manager-accounts
# and link the ad account to it first.
# ⚠ Access levels: "Test" is instant but only works against TEST accounts and will
# fail on the real one. "Basic" (what we need) is a short form + MANUAL REVIEW,
# typically 1–3 business days. Apply first — it gates every live API call.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Customer ID of the ad account to write to — DIGITS ONLY, no dashes.
# Where: top-right of any ads.google.com page, shown as 123-456-7890 → enter 1234567890.
# (Also under Admin → Account settings, and in the account picker dropdown.)
# The client normalizes dashes anyway, but store it clean.
GOOGLE_ADS_CUSTOMER_ID=

# Manager (MCC) customer ID, digits only — sent as the login-customer-id header.
# Required ONLY when the account above is accessed through a manager account.
# Leave empty when there is no MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# OAuth2 desktop-app client + a refresh token consented to the ADWORDS scope:
#   https://www.googleapis.com/auth/adwords
# ⚠ This is NOT the Merchant Center scope (.../auth/content). A refresh token is bound
# to the scopes it was consented with, so a GMC token CANNOT be reused here — it
# refreshes fine and then fails every Ads call. Mint a dedicated token, or one token
# consented to both scopes. Create the client at console.cloud.google.com →
# APIs & Services → Credentials → OAuth client ID → Desktop app (enable the
# "Google Ads API" in the API Library first, and add the Ameublo Google account as a
# Test user on the consent screen so the refresh token doesn't expire).
# The client also accepts the generic GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET /
# GOOGLE_REFRESH_TOKEN names as a fallback — only valid if that token carries the
# adwords scope.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Google Merchant Center account backing the Shopping feed. Already provisioned.
GOOGLE_MERCHANT_CENTER_ID=5804673777
